{
  "expo": {
    "name": "ReferTRM",
    "slug": "refertrm-mobile",
    "scheme": "refertrm",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#2A3764",
      "image": "./assets/icon.png"
    },
    "ios": {
      "bundleIdentifier": "com.refertrm.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.refertrm.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "backgroundColor": "#2A3764",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png"
      },
      "permissions": ["INTERNET", "ACCESS_NETWORK_STATE"],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            { "scheme": "refertrm", "host": "*", "pathPrefix": "/jobs" },
            { "scheme": "refertrm", "host": "*", "pathPrefix": "/learn" }
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "https",
              "host": "www.refertrm.com",
              "pathPrefix": "/jobs"
            },
            {
              "scheme": "https",
              "host": "www.refertrm.com",
              "pathPrefix": "/learn"
            }
          ]
        }
      ]
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "cae45fbe-c884-406f-929d-14468d7e3eeb"
      }
    }
  }
}
