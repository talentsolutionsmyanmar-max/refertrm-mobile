{
  "expo": {
    "name": "ReferTRM",
    "slug": "refertrm-mobile",
    "scheme": "refertrm",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#2B3767",
      "image": "./assets/icon.png"
    },
    "ios": {
      "bundleIdentifier": "com.refertrm.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.refertrm.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2B3767"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "www.refertrm.com",
              "pathPrefix": "/jobs"
            },
            {
              "scheme": "https",
              "host": "www.refertrm.com",
              "pathPrefix": "/learn"
            }
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/BricolageGrotesque-600.ttf",
            "./assets/fonts/Inter-400.ttf",
            "./assets/fonts/Inter-600.ttf",
            "./assets/fonts/JetBrainsMono-600.ttf",
            "./assets/fonts/Padauk-400.ttf",
            "./assets/fonts/Padauk-700.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "cae45fbe-c884-406f-929d-14468d7e3eeb"
      }
    }
  }
}
